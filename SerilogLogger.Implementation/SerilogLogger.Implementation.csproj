<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>

    <!-- NuGet Package Configuration -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>SerilogLogger.Implementation</PackageId>
    <PackageVersion>2.0.1</PackageVersion>
    <AssemblyVersion>2.0.1</AssemblyVersion>
    <FileVersion>2.0.1</FileVersion>
    <Version>2.0.1</Version>
    <Title>Serilog Logger Implementation</Title>
    <Authors>AliMoh</Authors>
    <Company>AM</Company>
    <Product>SerilogLogger</Product>
    <Description>Implementation of Serilog logging with normal and queue-based logging capabilities.</Description>
    <PackageTags>serilog;logging;implementation;async;queue</PackageTags>
    <PackageProjectUrl>https://github.com/yourrepo/seriloglogger</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yourrepo/seriloglogger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Implementation with optimized async logging and dependency injection.</PackageReleaseNotes>
    <Copyright>Copyright © AM 2025</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serilog Dependencies -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Udp" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SerilogLogger.Abstraction\SerilogLogger.Abstraction.csproj" />
  </ItemGroup>
</Project>