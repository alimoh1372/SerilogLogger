{
  "Serilog": {
    "Using": [ "Serilog", "Serilog.Sinks.File", "Serilog.Sinks.Udp" ],
    "MinimumLevel": "Verbose",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\SelilogLogger\\SerilogTest\\SerilogTest.txt",
          "outputTemplate": "Level      :{Level:u3}{NewLine}Message    :{Message}{NewLine}Time       :{Timestamp:yyyy-MM-dd HH:mm:ss.fff}{NewLine}Properties :{Properties:j}{NewLine}Exception  :{Exception}{NewLine}*******************************{NewLine}",
          "fileSizeLimitBytes": 268435456, // 256MB (256*2^20)
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "rollOnFileSizeLimit": true,
          "RestrictedToMinimumLevel": "Verbose"
        }
      },
      // write each level into its corresponding file
      {
        "Name": "File",
        "Args": {
          "path": "D:\\SelilogLogger\\SerilogTest\\InformationLogs.txt",
          "outputTemplate": "Level      :{Level:u3}{NewLine}Message    :{Message}{NewLine}Time       :{Timestamp:yyyy-MM-dd HH:mm:ss.fff}{NewLine}Properties :{Properties:j}{NewLine}Exception  :{Exception}{NewLine}*******************************{NewLine}",
          "fileSizeLimitBytes": 268435456, // 256MB (256*2^20)
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Information",
          "filter": "Level == 'Information'"
        }
      },
      {
        "Name": "Udp",
        "Args": {
          "remoteAddress": "127.0.0.1",
          "remotePort": 9999,
          "family": "InterNetwork",
          "formatter": "SerilogLogger.LogFormatter.ApplicationMonitor.Log4ApplicationMonitorFormatter, SerilogLogger",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithThreadName",
      "WithProcessName",
      "WithProcessId"
    ]
  }
}