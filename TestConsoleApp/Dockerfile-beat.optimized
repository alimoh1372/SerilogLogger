# Grab Filebeat binary from official image
FROM elastic/filebeat:9.1.3 AS filebeatbin

# Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0

# System dependencies (فقط ضروری)
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

# Create user and directories
RUN useradd -r -s /bin/false appuser \
 && mkdir -p /etc/filebeat /var/lib/filebeat/registry /var/lib/filebeat/queue /var/log/app /var/log/filebeat /app

# Copy pre-built application from host
COPY ./publish /app

# Copy Filebeat binary and config
COPY --from=filebeatbin /usr/share/filebeat/filebeat /usr/bin/filebeat
COPY docker/filebeat.yml /etc/filebeat/filebeat.yml

# Copy Serilog config
COPY LogConfiguration.json /app/LogConfiguration.json

# Create entrypoint
COPY docker/entrypoint.sh /entrypoint.sh

# Set permissions
RUN chmod +x /entrypoint.sh

# Set ownership
RUN chown -R appuser:appuser /var/log /etc/filebeat /var/lib/filebeat /app

# Environment variables
ENV FILEBEAT_DATA_DIR=/var/lib/filebeat
ENV DOTNET_SystemGlobalization_Invariant=false

# Expose ports
EXPOSE 9090

USER appuser
WORKDIR /app

ENTRYPOINT ["/entrypoint.sh"]