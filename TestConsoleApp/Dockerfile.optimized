# ===== Grab Vector binary from official image =====
FROM timberio/vector:0.49.0-debian AS vectorbin

# ===== Runtime =====
FROM mcr.microsoft.com/dotnet/aspnet:8.0

# System dependencies
RUN rm -rf /var/lib/apt/lists/*

RUN apt-get update 
RUN apt-get install -y ca-certificates curl bash coreutils procps jq cron 

# Create user and directories

RUN useradd -r -s /bin/false appuser \
 && mkdir -p /etc/vector /var/lib/vector /var/log/app /var/log/vector /opt/scripts

# Copy pre-built application from host
COPY ./publish /app

# Copy vector binary
COPY --from=vectorbin /usr/bin/vector /usr/bin/vector

# Copy configurations and scripts
COPY docker/vector.yaml /etc/vector/vector.yaml
COPY LogConfiguration.json /app/LogConfiguration.json
COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/file-cleanup-manager.sh /opt/scripts/file-cleanup-manager.sh

# Set permissions
RUN chmod +x /entrypoint.sh /opt/scripts/file-cleanup-manager.sh

# Set ownership
RUN chown -R appuser:appuser /var/log /etc/vector /var/lib/vector /opt/scripts

# Environment variables - ساده و واضح
ENV LOG_DIR=/var/log/app
ENV PROCESSED_DIR=/var/log/app-processed
ENV VECTOR_DATA_DIR=/var/lib/vector
ENV PROCESSED_RETENTION_DAYS=7
ENV SCRIPT_PATH=/opt/scripts/file-cleanup-manager.sh
ENV LOG_PATH=/var/log/vector
ENV DOTNET_SystemGlobalization_Invariant=false

# Expose ports
EXPOSE 9090 8686

USER appuser
WORKDIR /app

ENTRYPOINT ["/entrypoint.sh"]