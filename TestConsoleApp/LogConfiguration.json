{
  "LogConfiguration": {
    "LoggerType": "Normal",
    "SerilogSelfErrorLogs": "logs\\serilog-errors.log",
    "EnablePerformanceLogging": false,
    "EnableMethodCallTracking": false,
    "MaxObjectDepth": 1,
    "MaxCollectionItems": 0,
    "EnableAsyncLogging": true,
    "AsyncBufferSize": 10000,
    "AsyncFlushInterval": "00:00:01",
    "EnableContextualProperties": true,
    "EnableExceptionDetails": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Expressions"
    ],
    "Properties": {
      "ApplicationId": "App123",
      "ApplicationName": "SampleApp"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "/var/log/app/log-.json",
                "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 104857600,
                "retainedFileCountLimit": null,
                "buffered": true,
                "flushToDiskInterval": "00:00:01",
                "shared": false
              }
            }
          ],
          "bufferSize": 10000,
          "blockWhenFull": false
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId",
      "WithThreadName",
      "WithProcessName"
    ]
  }
}