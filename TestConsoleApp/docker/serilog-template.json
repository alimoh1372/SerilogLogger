{
  "index_patterns": ["serilog-logs-*"],
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "properties": {
      "@timestamp": { "type": "date" },
      "app_level":   { "type": "keyword" },
      "app_message": { "type": "text" },
      "app_class_name": { "type": "keyword" },
      "app_process_id": { "type": "integer" },
      "app_thread_id": { "type": "integer" }
    }
  }
}
